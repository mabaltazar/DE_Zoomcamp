# ================================================
# Copy this file to .env and fill in your actual values:
#   cp .env.example .env
#
# NEVER commit the actual .env file to git.
# ================================================

# GCP Service Account credentials (Base64-encoded JSON key file)
# To generate this value, run:
#   base64 -w 0 your-service-account-key.json        (Linux)
#   base64 -i your-service-account-key.json           (macOS)
# Then paste the output as the value below.
SECRET_GCP_CREDS=your-base64-encoded-service-account-json-here